# PyVerify frontend configuration — copy to `.env.local` to override.
# No secrets belong here: every NEXT_PUBLIC_* value is shipped to the browser.

# Base URL of the running PyVerify backend (no trailing slash).
# Default when unset: http://127.0.0.1:8766
NEXT_PUBLIC_PYVERIFY_API_BASE_URL=http://127.0.0.1:8766

# Request timeout for verification calls, in milliseconds (default 120000).
NEXT_PUBLIC_PYVERIFY_TIMEOUT_MS=120000
